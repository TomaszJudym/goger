2":"https:\/\/images.gog.com\/73d40908e4b503067704e15795d4e482f627f3463bafa5c235248a805d664432_menu_user_av_big2.jpg"}},"counters":{"games":383,"reviews":4}},"labels":["in_development"],"votes":{"downvotes":3,"upvotes":4},"date":"2019-04-20T12:39:37+03:00","creationDate":"2019-04-20T12:39:37+03:00","internalUpdateDate":"","_links":{"vote":{"href":"https:\/\/reviews.gog.com\/v1\/products\/1453298883\/reviews\/363eafc4-6350-11e9-9958-00163e4e60cc\/votes"},"report":{"href":"https:\/\/reviews.gog.com\/v1\/products\/1453298883\/reviews\/363eafc4-6350-11e9-9958-00163e4e60cc\/reports"}}},{"id":"74385bea-55bd-11e9-ac31-00163e97122a","productId":"1453298883","rating":{"value":5},"content":{"title":"This is how you DIE...","description":"This game is so good as is.  It has sooo much more promise if they achieve half of what they have said they would.  Mods are heavily recommended though which might be a con for some.  Not a game you can play constantly, but a ton of fun to play for a month or two, leave for a few months, then come back and learn something new all over again.  Plus, updates are slow to come, but they are pretty good.  They really need to add NPCs though.  A literal game changer when that happens.  If you like zombie games, this is one of the best sims for the zombie apocalypse.  My zombie fix usually is a rotation of this game and State of Decay 2.","language":"en-US"},"reviewer":{"id":"46987680209338186","username":"waceycs","avatar":{"links":{"gog_image_id":"c2cfe5203e546b2cb9a0128a662e887f8cacc80d4403e8401dffce316f98ed8e","small":"https:\/\/images.gog.com\/c2cfe5203e546b2cb9a0128a662e887f8cacc80d4403e8401dffce316f98ed8e_avs.jpg","small_2x":"https:\/\/images.gog.com\/c2cfe5203e546b2cb9a0128a662e887f8cacc80d4403e8401dffce316f98ed8e_avs2.jpg","medium":"https:\/\/images.gog.com\/c2cfe5203e546b2cb9a0128a662e887f8cacc80d4403e8401dffce316f98ed8e_avm.jpg","medium_2x":"https:\/\/images.gog.com\/c2cfe5203e546b2cb9a0128a662e887f8cacc80d4403e8401dffce316f98ed8e_avm2.jpg","large":"https:\/\/images.gog.com\/c2cfe5203e546b2cb9a0128a662e887f8cacc80d4403e8401dffce316f98ed8e_avl.jpg","large_2x":"https:\/\/images.gog.com\/c2cfe5203e546b2cb9a0128a662e887f8cacc80d4403e8401dffce316f98ed8e_avl2.jpg","sdk_img_32":"https:\/\/images.gog.com\/c2cfe5203e546b2cb9a0128a662e887f8cacc80d4403e8401dffce316f98ed8e_sdk_img32.jpg","sdk_img_64":"https:\/\/images.gog.com\/c2cfe5203e546b2cb9a0128a662e887f8cacc80d4403e8401dffce316f98ed8e_sdk_img64.jpg","sdk_img_184":"https:\/\/images.gog.com\/c2cfe5203e546b2cb9a0128a662e887f8cacc80d4403e8401dffce316f98ed8e_sdk_img184.jpg","menu_small":"https:\/\/images.gog.com\/c2cfe5203e546b2cb9a0128a662e887f8cacc80d4403e8401dffce316f98ed8e_menu_user_av_small.jpg","menu_small_2":"https:\/\/images.gog.com\/c2cfe5203e546b2cb9a0128a662e887f8cacc80d4403e8401dffce316f98ed8e_menu_user_av_small2.jpg","menu_big":"https:\/\/images.gog.com\/c2cfe5203e546b2cb9a0128a662e887f8cacc80d4403e8401dffce316f98ed8e_menu_user_av_big.jpg","menu_big_2":"https:\/\/images.gog.com\/c2cfe5203e546b2cb9a0128a662e887f8cacc80d4403e8401dffce316f98ed8e_menu_user_av_big2.jpg"}},"counters":{"games":48,"reviews":1}},"labels":["in_development","verified_owner"],"votes":{"downvotes":5,"upvotes":9},"date":"2019-04-03T06:10:48+03:00","creationDate":"2019-04-03T06:06:19+03:00","internalUpdateDate":"","_links":{"vote":{"href":"https:\/\/reviews.gog.com\/v1\/products\/1453298883\/reviews\/74385bea-55bd-11e9-ac31-00163e97122a\/votes"},"report":{"href":"https:\/\/reviews.gog.com\/v1\/products\/1453298883\/reviews\/74385bea-55bd-11e9-ac31-00163e97122a\/reports"}}},{"id":"dff368aa-1442-11e9-91fd-00163e4e60cc","productId":"1453298883","rating":{"value":2},"content":{"title":"Fun little \"sims-esque\" game","description":"This game feels like someone took the sims game and let you actually control your characters like in a top down shooter. There's zombies, and you gotta collect trash and make useful stuff and run away or hit them with a baseball bat. It's really fun but then you just get depressed from how repetitive it gets. it becomes a huge painful grind to no particular goal, sort of like real life! I really enjoyed the experience of surviving but that's really all that there is... after you board up the doors and windows with planks and open a can of beans with a can opener, it feels like you have done everything the game has to offer. Everything feels the same. I feel like if someone modded the game to remove the zombies and replaced the zombies with one extremely scary monster that is hunting your character, added darker scarier spookier night-time, creepy music, and made you feel like something was coming to get you and made you really feel like you should really board up your house and hide at night and make no noise and turn the lights off and wait in total fear and horror, maybe the game would be a total hit, but even if you customize the zombies to be undead-superman they still behave the same way, but just slightly faster and more violent and numerous. Really, the zombies are a very boring and unchallenging threat that doesn't feel scary when they do finally get you. I love the tutorial though, which was very very original, but that's it... I'm a huge fan of zombies, but I feel that no game has ever got even remotely close to the correct feel for how zombies and the zombie survival experience should be, AAA cashgrab or humble little indie game alike. Too bad nobody wants to make a shaun of the dead crossed with 28 days later videogame. That felt close to what it should be like, but just movies... I'll give it 2 stars but I wanted to give it 2.5 but there's no option for that setting available as of right now. It's good, for like an hour...","language":"en-US"},"reviewer":{"id":"51591931764412684","username":"fridgeband","avatar":{"links":{"gog_image_id":"9daa6d68f78f5480145e856dfb77fb12a0c41b6de147e8b63aac5f26adc76911","small":"https:\/\/images.gog.com\/9daa6d68f78f5480145e856dfb77fb12a0c41b6de147e8b63aac5f26adc76911_av