0d99c50bf82e19aacc8e4bc3bd02da7c7e8c6_sdk_img64.jpg","sdk_img_184":"https:\/\/images.gog.com\/e380dd5e8249f4ce94a3f215ccf0d99c50bf82e19aacc8e4bc3bd02da7c7e8c6_sdk_img184.jpg","menu_small":"https:\/\/images.gog.com\/e380dd5e8249f4ce94a3f215ccf0d99c50bf82e19aacc8e4bc3bd02da7c7e8c6_menu_user_av_small.jpg","menu_small_2":"https:\/\/images.gog.com\/e380dd5e8249f4ce94a3f215ccf0d99c50bf82e19aacc8e4bc3bd02da7c7e8c6_menu_user_av_small2.jpg","menu_big":"https:\/\/images.gog.com\/e380dd5e8249f4ce94a3f215ccf0d99c50bf82e19aacc8e4bc3bd02da7c7e8c6_menu_user_av_big.jpg","menu_big_2":"https:\/\/images.gog.com\/e380dd5e8249f4ce94a3f215ccf0d99c50bf82e19aacc8e4bc3bd02da7c7e8c6_menu_user_av_big2.jpg"}},"counters":{"games":0,"reviews":1}},"labels":["in_development"],"votes":{"downvotes":8,"upvotes":11},"date":"2016-01-30T22:31:07+02:00","creationDate":"2016-01-30T22:31:07+02:00","internalUpdateDate":"","_links":{"vote":{"href":"https:\/\/reviews.gog.com\/v1\/products\/1453298883\/reviews\/45789ee4-9a26-11e8-b5b9-00163e97122a\/votes"},"report":{"href":"https:\/\/reviews.gog.com\/v1\/products\/1453298883\/reviews\/45789ee4-9a26-11e8-b5b9-00163e97122a\/reports"}}},{"id":"16d128c2-9a26-11e8-b6c8-00163e97122a","productId":"1453298883","rating":{"value":5},"content":{"title":"My favorite non-FPS zombie game","description":"So, yeah, anything I'd write here is biased by the fact that I've played this game for hundreds of hours and probably put just as much time into modding and other related projects.\n\nIn this game you play as an average person, not some one-man-army saving mankind from its peril. You WILL die. You will die A LOT. And yet you will come back, adjust your strategy and survive a bit longer this time.\nYou will learn that trying to shoot something as an unemployed farmer that never held a gun before will not yield the effect you hoped for.\nYou will learn that running around will tire you out and you will need to actually spend time resting to recovery.\nYou will learn that hiding behind a wall for three seconds will not refill your health bar.\nAnd you will learn that - just as in real life - things are difficult. And just as in real life, you will come back to learn it, to improve and to manage just one more day.\n\nAnd you will be happy for that.\n\nI've played this game since June '11 when it was only available via TIS' own website. I've followed the game to Desura, to Steam and now here.\nThe community around this game is - barring some bad examples - one of the nicest and most helpful I've ever encountered, so long as you aren't a dick to the community yourself.\n\nThe games development is not really undergoing any big changes at any one time, but there are many small changes going on at any one time and you see it in the changelogs, in the features that are added, in the many small things that change in every release.\nIf you want a game that radically changes with every minor version number, this is not for you. But if you can appreciate lots of small changes in a way that you won't recognize the game three major releases down the road without even recognizing how much it changed in that time, give it a go.","language":"en-US"},"reviewer":{"id":"46988828910723426","username":"blindcoder","avatar":{"links":{"gog_image_id":"b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003","small":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_avs.jpg","small_2x":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_avs2.jpg","medium":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_avm.jpg","medium_2x":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_avm2.jpg","large":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_avl.jpg","large_2x":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_avl2.jpg","sdk_img_32":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_sdk_img32.jpg","sdk_img_64":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_sdk_img64.jpg","sdk_img_184":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_sdk_img184.jpg","menu_small":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_menu_user_av_small.jpg","menu_small_2":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_menu_user_av_small2.jpg","menu_big":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_menu_user_av_big.jpg","menu_big_2":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_menu_user_av_big2.jpg"}},"counters":{"games":330,"reviews":1}},"labels":["in_development","verified_owner"],"votes":{"downvotes":7,"upvotes":14},"date":"2016-01-30T11:18:16+02:00","creationDate":"2016-01-30T11:18:16+02:00","internalUpdateDate":"","_links":{"vote":{"href":"https:\/\/reviews.gog.com\/v1\/products\/1453298883\/reviews\/16d128c2-9a26-11e8-b6c8-00163e97122a\/votes"},"report":{"href":"https:\/\/reviews.gog.com\/v1\/products\/1453298883\/reviews\/16d128c2-9a26-11e8-b6c8-00163e97122a\/reports"}}},{"id":"fb4a6b90-9a25-11e8-b9f4-00163e97122a","productId":"1453298883","rating":{"value":5},"content":{"title":"My best game purchase ever","description":"Best Zombie\/Survival\/Crafting game I have played - period. It's the ultimate, \"how would I try and survive in a Zombie Apocalypse?\" game. The amount of tweakable options is amazing, make it as hard, or as easy as you want. I've got well over 500 hours invested in the Steam version of this, and many more before it even made it to Steam.\n\nI've seen some criticism regarding the speed of development, but so what? It's immensely playable right now, and they are still working on it. The Devs are some of the best I have seen and actually care about their product. Hell, they could've just slapped a \"1.0 complete\" sticker on it and walked away, as many other developers have, (including AAA titles!), but they haven't. Visit the forums, you'll see that the Devs are constantly involved with the community. Watch some \"Let's play\" on YouTube, and it will give you an idea of how truly brilliant this title is.","language":"en-US"},"reviewer":{"id":"46988944165194747","username":"EreWeGo","avatar":{"links":{"gog_image_id":"3f9e109ac09308f7d52c607c8571e63d5fb482acca499a83e767dfff7f00d57d","small":"https:\/\/images.gog.com\/3f9e109ac09308f7d52c607c8571e63d5fb482acca499a83e767dfff7f00d57d_avs.jpg","small_2x":"https:\/\/images.gog.com\/3f9e109ac09308f7d52c607c8571e63d5fb482acca499a83e767dfff7f00d57d_avs2.jpg","medium":"https:\/\/images.gog.com\/3f9e109ac09308f7d52c607c8571e63d5fb482acca499a83e767dfff7f00d57d_avm.jpg","medium_2x":"https:\/\/images.gog.com\/3f9e109ac09308f7d52c607c8571e63d5fb482acca499a83e767dfff7f00d57d_avm2.jpg","large":"https:\/\/images.gog.com\/3f9e109ac09308f7d52c607c8571e63d5fb482acca499a83e767dfff7f00d57d_avl.jpg","large_2x":"https:\/\/images.gog.com\/3f9e109ac09308f7d52c607c8571e63d5fb482acca499a83e767dfff7f00d57d_avl2.jpg","sdk_img_32":"https:\/\/images.gog.com\/3f9e109ac09308f7d52c607c8571e63d5fb482acca499a83e767dfff7f00d57d_sdk_img32.jpg","sdk_img_64":"https:\/\/images.gog.com\/3f9e109ac09308f7d52c607c8571e63d5fb482acca499a83e767dfff7f00d57d_sdk_img64.jpg","sdk_img_184":"https:\/\/images.gog.com\/3f9e109ac09308f7d52c607c8571e63d5fb482acca499a83e767dfff7f00d57d_sdk_img184.jpg","menu_small":"https:\/\/images.gog.com\/3f9e109ac09308f7d52c607c8571e63d5fb482acca499a83e767dfff7f00d57d_menu_user_av_small.jpg","menu_small_2":"https:\/\/images.gog.com\/3f9e109ac09308f7d52c607c8571e63d5fb482acca499a83e767dfff7f00d57d_menu_user_av_small2.jpg","menu_big":"https:\/\/images.gog.com\/3f9e109ac09308f7d52c607c8571e63d5fb482acca499a83e767dfff7f00d57d_menu_user_av_big.jpg","menu_big_2":"https:\/\/images.gog.com\/3f9e109ac09308f7d52c607c8571e63d5fb482acca499a83e767dfff7f00d57d_menu_user_av_big2.jpg"}},"counters":{"games":97,"reviews":1}},"labels":["in_development","verified_owner"],"votes":{"downvotes":18,"upvotes":33},"date":"2016-01-30T00:19:41+02:00","creationDate":"2016-01-30T00:19:41+02:00","internalUpdateDate":"","_links":{"vote":{"href":"https:\/\/reviews.gog.com\/v1\/products\/1453298883\/reviews\/fb4a6b90-9a25-11e8-b9f4-00163e97122a\/votes"},"report":{"href":"https:\/\/reviews.gog.com\/v1\/products\/1453298883\/reviews\/fb4a6b90-9a25-11e8-b9f4-00163e97122a\/reports"}}},{"id":"f32bb5e0-9a25-11e8-b58e-00163e97122a","productId":"1453298883","rating":{"value":5},"content":{"title":"IMHO the best zombie survival game","description":"I'm going to keep this review short:\n\n1. I have spent more than 1000 hours playing this game.\n2. I don't regret it.","language":"en-US"},"reviewer":{"id":"46988212779833343","username":"gerasozord","avatar":{"links":{"gog_image_id":"dc04bc12a18055a2cac55cc49badcfc43ab106c5802c71213ed1b693eb5d15b3","small":"https:\/\/images.gog.com\/dc04bc12a18055a2cac55cc49badcfc43ab106c5802c71213ed1b693eb5d15b3_avs.jpg","small_2x":"https:\/\/images.gog.com\/dc04bc12a18055a2cac55cc49badcfc43ab106c5802c71213ed1b693eb5d15b3_avs2.jpg","medium":"https:\/\/images.gog.com\/dc04bc12a18055a2cac55cc49badcfc43ab106c5802c71213ed1b693eb5d15b3_avm.jpg","medium_2x":"https:\/\/images.gog.com\/dc04bc12a18055a2cac55cc49badcfc43ab106c5802c71213ed1b693eb5d15b3_avm2.jpg","large":"https:\/\/images.gog.com\/dc04bc12a18055a2cac55cc49badcfc43ab106c5802c71213ed1b693eb5d15b3_avl.jpg","large_2x":"https:\/\/images.gog.com\/dc04bc12a18055a2cac55cc49badcfc43ab106c5802c71213ed1b693eb5d15b3_avl2.jpg","sdk_img_32":"https:\/\/images.gog.com\/dc04bc12a18055a2cac55cc49badcfc43ab106c5802c71213ed1b693eb5d15b3_sdk_img32.jpg","sdk_img_64":"https:\/\/images.gog.com\/dc04bc12a18055a2cac55cc49badcfc43ab106c5802c71213ed1b693eb5d15b3_sdk_img64.jpg","sdk_img_184":"https:\/\/images.gog.com\/dc04bc12a18055a2cac55cc49badcfc43ab106c5802c71213ed1b693eb5d15b3_sdk_img184.jpg","menu_small":"https:\/\/images.gog.com\/dc04bc12a18055a2cac55cc49badcfc43ab106c5802c71213ed1b693eb5d15b3_menu_user_av_small.jpg","menu_small_2":"https:\/\/images.gog.com\/dc04bc12a18055a2cac55cc49badcfc43ab106c5802c71213ed1b693eb5d15b3_menu_user_av_small2.jpg","menu_big":"https:\/\/images.gog.com\/dc04bc12a18055a2cac55cc49badcfc43ab106c5802c71213ed1b693eb5d15b3_menu_user_av_big.jpg","menu_big_2":"https:\/\/images.gog.com\/dc04bc12a18055a2cac55cc49badcfc43ab106c5802c71213ed1b693eb5d15b3_menu_user_av_big2.jpg"}},"counters":{"games":56,"reviews":2}},"labels":["in_development","verified_owner"],"votes":{"downvotes":16,"upvotes":30},"date":"2016-01-29T22:55:29+02:00","creationDate":"2016-01-29T22:55:29+02:00","internalUpdateDate":"","_links":{"vote":{"href":"https:\/\/reviews.gog.com\/v1\/products\/1453298883\/reviews\/f32bb5e0-9a25-11e8-b58e-00163e97122a\/votes"},"report":{"href":"https:\/\/reviews.gog.com\/v1\/products\/1453298883\/reviews\/f32bb5e0-9a25-11e8-b58e-00163e97122a\/reports"}}},{"id":"2173028e-c585-11e8-af29-00163e97122a","productId":"1453298883","rating":{"value":4},"content":{"title":"Great, but not without its flaws.","description":"I first played Project Zomboid back when it was being sold on the old website with the old 2D graphics and the Kate &amp; Baldspot characters were still in Project Zomboid; I stuck with the community for a long time from its.. Younger years to the more welcoming, friendly recent years.\n\nI haven't had too much time to put into Project Zomboid because of the fact that I'm in college now and quite busy, but from what I have played I'll put the pro's and con's below:\nPros:\n- Great, in-depth game which sacrifices having big fancy-shiny graphics for complex systems and interesting mechanics.\n\n- Has a unique take on the Zombie Genre by allow you to customize the zombies behavior and the general cruelty of the world in a 'Sandbox' game mode. You can customize the undead from their ability to see and smell right onto how they move (you can set zombies as runners if you wanted to) and behave.\n\n- A plethora of skills to choose from which all have their effect on your character.\n\n- Ever hear that song \"Dumb ways to die\"? Yeah that'll be you when you start this game. don't worry, everybody remembers their first. (Mine was a soup fire)\n\nCons:\n- The learning curve for Survival can be quite steep and a lot of people complain about this; Which is understandable.\nNOTE: There is a sandbox mode where you can adjust Zombie Behavior, loot spawn rates, etc, etc.. If Survival is proving too difficult for you, there's no shame in playing on Sandbox.\n\n- The isometric Graphics might put people off, but if you can sit down and honestly give the game a shot, you might find it's actually like a transformer: \"More than meets the eye\"; However I know for some people this style of aesthetic is just a no-go, which is fine, we're all entitled to our tastes.\n\nNOTE:\nThis is all based on single-player experiences as I haven't really bothered to touch Multiplayer, this has always been a single-player game to me out of fond nostalgia of the older builds.","language":"en-US"},"reviewer":{"id":"46988696035826951","username":"KittFrostpaws","avatar":{"links":{"gog_image_id":"b5d317e70e1037b6db42792291d5dec433e3c314a3dfde7c49f32f85fb0421a6","small":"https:\/\/images.gog.com\/b5d317e70e1037b6db42792291d5dec433e3c314a3dfde7c49f32f85fb0421a6_avs.jpg","small_2x":"https:\/\/images.gog.com\/b5d317e70e1037b6db42792291d5dec433e3c314a3dfde7c49f32f85fb0421a6_avs2.jpg","medium":"https:\/\/images.gog.com\/b5d317e70e1037b6db42792291d5dec433e3c314a3dfde7c49f32f85fb0421a6_avm.jpg","medium_2x":"https:\/\/images.gog.com\/b5d317e70e1037b6db42792291d5dec433e3c314a3dfde7c49f32f85fb0421a6_avm2.jpg","large":"https:\/\/images.gog.com\/b5d317e70e1037b6db42792291d5dec433e3c314a3dfde7c49f32f85fb0421a6_avl.jpg","large_2x":"https:\/\/images.gog.com\/b5d317e70e1037b6db42792291d5dec433e3c314a3dfde7c49f32f85fb0421a6_avl2.jpg","sdk_img_32":"https:\/\/images.gog.com\/b5d317e70e1037b6db42792291d5dec433e3c314a3dfde7c49f32f85fb0421a6_sdk_img32.jpg","sdk_img_64":"https:\/\/images.gog.com\/b5d317e70e1037b6db42792291d5dec433e3c314a3dfde7c49f32f85fb0421a6_sdk_img64.jpg","sdk_img_184":"https:\/\/images.gog.com\/b5d317e70e1037b6db42792291d5dec433e3c314a3dfde7c49f32f85fb0421a6_sdk_img184.jpg","menu_small":"https:\/\/images.gog.com\/b5d317e70e1037b6db42792291d5dec433e3c314a3dfde7c49f32f85fb0421a6_menu_user_av_small.jpg","menu_small_2":"https:\/\/images.gog.com\/b5d317e70e1037b6db42792291d5dec433e3c314a3dfde7c49f32f85fb0421a6_menu_user_av_small2.jpg","menu_big":"https:\/\/images.gog.com\/b5d317e70e1037b6db42792291d5dec433e3c314a3dfde7c49f32f85fb0421a6_menu_user_av_big.jpg","menu_big_2":"https:\/\/images.gog.com\/b5d317e70e1037b6db42792291d5dec433e3c314a3dfde7c49f32f85fb0421a6_menu_user_av_big2.jpg"}},"counters":{"games":28,"reviews":1}},"labels":["in_development"],"votes":{"downvotes":25,"upvotes":80},"date":"2016-01-29T21:51:29+02:00","creationDate":"2016-01-29T21:51:29+02:00","internalUpdateDate":"","_links":{"vote":{"href":"https:\/\/reviews.gog.com\/v1\/products\/1453298883\/reviews\/2173028e-c585-11e8-af29-00163e97122a\/votes"},"report":{"href":"https:\/\/reviews.gog.com\/v1\/products\/1453298883\/reviews\/2173028e-c585-11e8-af29-00163e97122a\/reports"}}},{"id":"edfe9178-9a25-11e8-b520-00163e97122a","productId":"1453298883","rating":{"value":4},"content":{"title":"Its Aight","description":"You will eventually die, maybe you fall off a roof or your planned exit route gets blocked. Doesn't matter, its gonna happen whether its an hour in or 1000 hours in.\n\nI picked this game up last year and I have not encountered a bug yet but a lot of the features promised have not been released yet. I don't know what the devs are doing tbh, that guy below me is right on the fact they got some guy(s) hammering on a keyboard to pump out text for some blog probably to distract people from the missing features. \n\nMultiplayer is pretty fun once you figure out what mods or add-ons the servers are using, just beware its almost as bad as Rust if there are no rules. You will probably be blasted at spawn.\n\nThis is as low as the price is gonna be till after release, the Devs way to thanking the early backers of this game.","language":"en-US"},"reviewer":{"id":"46987728382064083","username":"Stearmolled","avatar":{"links":{"gog_image_id":"39f88b7915e872d5123f9d16e3393f4eb99c6ed2cd2fcd7accf0254ea095000c","small":"https:\/\/images.gog.com\/39f88b7915e872d5123f9d16e3393f4eb99c6ed2cd2fcd7accf0254ea095000c_avs.jpg","small_2x":"https:\/\/images.gog.com\/39f88b7915e872d5123f9d16e3393f4eb99c6ed2cd2fcd7accf0254ea095000c_avs2.jpg","medium":"https:\/\/images.gog.com\/39f88b7915e872d5123f9d16e3393f4eb99c6ed2cd2fcd7accf0254ea095000c_avm.jpg","medium_2x":"https:\/\/images.gog.com\/39f88b7915e872d5123f9d16e3393f4eb99c6ed2cd2fcd7accf0254ea095000c_avm2.jpg","large":"https:\/\/images.gog.com\/39f88b7915e872d5123f9d16e3393f4eb99c6ed2cd2fcd7accf0254ea095000c_avl.jpg","large_2x":"https:\/\/images.gog.com\/39f88b7915e872d5123f9d16e3393f4eb99c6ed2cd2fcd7accf0254ea095000c_avl2.jpg","sdk_img_32":"https:\/\/images.gog.com\/39f88b7915e872d5123f9d16e3393f4eb99c6ed2cd2fcd7accf0254ea095000c_sdk_img32.jpg","sdk_img_64":"https:\/\/images.gog.com\/39f88b7915e872d5123f9d16e3393f4eb99c6ed2cd2fcd7accf0254ea095000c_sdk_img64.jpg","sdk_img_184":"https:\/\/images.gog.com\/39f88b7915e872d5123f9d16e3393f4eb99c6ed2cd2fcd7accf0254ea095000c_sdk_img184.jpg","menu_small":"https:\/\/images.gog.com\/39f88b7915e872d5123f9d16e3393f4eb99c6ed2cd2fcd7accf0254ea095000c_menu_user_av_small.jpg","menu_small_2":"https:\/\/images.gog.com\/39f88b7915e872d5123f9d16e3393f4eb99c6ed2cd2fcd7accf0254ea095000c_menu_user_av_small2.jpg","menu_big":"https:\/\/images.gog.com\/39f88b7915e872d5123f9d16e3393f4eb99c6ed2cd2fcd7accf0254ea095000c_menu_user_av_big.jpg","menu_big_2":"https:\/\/images.gog.com\/39f88b7915e872d5123f9d16e3393f4eb99c6ed2cd2fcd7accf0254ea095000c_menu_user_av_big2.jpg"}},"counters":{"games":44,"reviews":2}},"labels":["in_development","verified_owner"],"votes":{"downvotes":8,"upvotes":7},"date":"2016-01-29T21:12:35+02:00","creationDate":"2016-01-29T21:12:35+02:00","internalUpdateDate":"","_links":{"vote":{"href":"https:\/\/reviews.gog.com\/v1\/products\/1453298883\/reviews\/edfe9178-9a25-11e8-b520-00163e97122a\/votes"},"report":{"href":"https:\/\/reviews.gog.com\/v1\/products\/1453298883\/reviews\/edfe9178-9a25-11e8-b520-00163e97122a\/reports"}}},{"id":"bfbeeab0-9a25-11e8-a9f6-00163e97122a","productId":"1453298883","rating":{"value":2},"content":{"title":"Great concept bad development cycle","description":"I have this game for almost a year now on steam. As some people write in their reviews, this game is  an eternity in development state. Progress in development is extremely slow but the amount on text on their development news blog on the other side is huge. It seems their writers are better than their developers. I liked the game a lot and the game itself has a great concept but without npcs, quests and a lot of still unfixed bugs makes this game boring and tedious to play.\n\nYou don\u00b4t see equipped bags and some weapons and items share the same sprites. The survival aspect of the game is good, and the finished and bug free version of the game sure deserves a much better rating. But until then its no more than 2 stars.","language":"en-US"},"reviewer":{"id":"47945020620537676","username":"sacoji","avatar":{"links":{"gog_image_id":"b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003","small":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_avs.jpg","small_2x":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_avs2.jpg","medium":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_avm.jpg","medium_2x":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_avm2.jpg","large":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_avl.jpg","large_2x":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_avl2.jpg","sdk_img_32":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_sdk_img32.jpg","sdk_img_64":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_sdk_img64.jpg","sdk_img_184":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_sdk_img184.jpg","menu_small":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_menu_user_av_small.jpg","menu_small_2":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_menu_user_av_small2.jpg","menu_big":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_menu_user_av_big.jpg","menu_big_2":"https:\/\/images.gog.com\/b22b5e1aa66ce2027d57e140e28bc5c088c28b3ad523aa8108a0b842f1264003_menu_user_av_big2.jpg"}},"counters":{"games":269,"reviews":4}},"labels":["in_development","verified_owner"],"votes":{"downvotes":99,"upvotes":171},"date":"2016-01-29T10:22:15+02:00","creationDate":"2016-01-29T10:22:15+02:00","internalUpdateDate":"","_links":{"vote":{"href":"https:\/\/reviews.gog.com\/v1\/products\/1453298883\/reviews\/bfbeeab0-9a25-11e8-a9f6-00163e97122a\/votes"},"report":{"href":"https:\/\/reviews.gog.com\/v1\/products\/1453298883\/reviews\/bfbeeab0-9a25-11e8-a9f6-00163e97122a\/reports"}}},{"id":"b90da27e-9a25-11e8-8fdf-00163e97122a","productId":"1453298883","rating":{"value":5},"content":{"title":"Zombies are not your greatest enemy","description":"(My first review because I see so much potential in this game. I don't play it every day, but I feel strongly about it.)\n\nI am so glad this game has arrived on GOG. I purchased the game on Steam on a hunch because of my love for survival games. I had tried Neo Scavenger, and while I appreciated the realism, it lacked the atmosphere necessary to make it an engrossing experience.\n\nProject Zomboid (despite a regrettable name) is an challenging survival game... with zombies. That is--this is NOT Left4Dead, this is NOT Dead Island, this isn't even State of Decay (though we are getting warmer). This is a survival game where zombies block your path to life. Leaving your house and exploring is something you MUST do to live (food, weapons, home protection, minimizing visibility, etc) and facing a single zombie could result in your death. Breaking a glass window to enter a home and grab a can of food (or nails to board up your base's windows) can lead to cuts, which can lead to infection, which can lead to death.\n\nYes--this game is still in development. Yes--it has taken a while to improve. Yes--there is not yet a story mode or NPCs or other adventure-type aspects. Yes--it can be brutally hard. But make no mistake... it is a game you will think about and strategize over when you are not a But GOG is a huge step for this game. Developers can't grow unless they have support and financial backing to take the next step. And I hope this is a step in the right direction for this game.\n\nI love this game because it is not only an excellent survival game, but it also carries tons of potential. Don't fear the \"in development\" tag so long as you know what you are getting into. A difficult, realistic (except for the living dead) zombie game that will test your survival skills in the apocalypse. It is a game that you will actually care when you die.","language":"en-US"},"reviewer":{"id":"46987586461870153","username":"Apulver","avatar":{"links":{"gog_image_id":"dc04bc12a18055a2cac55cc49badcfc43ab106c5802c71213ed1b693eb5d15b3","small":"ht